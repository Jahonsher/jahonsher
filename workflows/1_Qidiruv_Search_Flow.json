      "id": "Instagram_dedup_oqish",
      "name": "Instagram dedup oqish",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        940,
        200
      ],
      "credentials": {
        "googleApi": {
          "id": "REPLACE_GOOGLE",
          "name": "Google API (Service Account)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Buyruqni tanlash').first().json;\nconst existingRows = $('Instagram dedup oqish').all().map(i => i.json);\nconst existing = {};\nfor (const r of existingRows) {\n  const id = (r['Post IDsi'] == null ? '' : r['Post IDsi'].toString().trim());\n  if (id) existing[id] = true;\n}\nconst sd = $getWorkflowStaticData('global');\nsd.searchState = {\n  query: cfg.query,\n  date_posted: cfg.date_posted,\n  cutoffTs: Math.floor(Date.now() / 1000) - cfg.cutoffDays * 24 * 60 * 60,\n  miqdor: cfg.miqdor,\n  rowNumber: cfg.rowNumber,\n  page: 1,\n  startTime: Date.now(),\n  collected: [],\n  existing,\n  noMore: false\n};\nreturn [{ json: { started: true } }];"
      },
      "id": "Loop_sozlash",
      "name": "Loop sozlash",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $getWorkflowStaticData('global').searchState;\nlet done = false;\nif (Date.now() - s.startTime > 5 * 60 * 1000) done = true;\nif (s.collected.length >= s.miqdor) done = true;\nif (s.noMore) done = true;\nif (s.page > 20) done = true;\nreturn [{ json: { done, page: s.page, collected: s.collected.length } }];"
      },
