      "id": "ScrapeCreators_qidiruv",
      "name": "ScrapeCreators qidiruv",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1820,
        400
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_SCRAPECREATORS",
          "name": "ScrapeCreators (x-api-key)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const s = $getWorkflowStaticData('global').searchState;\nconst resp = $input.first().json || {};\nfunction pick(o, paths) {\n  for (const p of paths) {\n    const v = p.split('.').reduce((a, k) => (a == null ? undefined : a[k]), o);\n    if (v !== undefined && v !== null && v !== '') return v;\n  }\n  return undefined;\n}\nlet reels = resp.reels || resp.data || resp.items || resp.results || [];\nif (!Array.isArray(reels)) reels = [];\nif (reels.length === 0) { s.noMore = true; }\nfor (const reel of reels) {\n  const m = reel.media || reel.node || reel;\n  let id = (pick(m, ['id', 'pk', 'code', 'shortcode']) || '').toString();\n  id = id.split('_')[0];\n  if (!id) continue;\n  if (s.existing[id]) continue;\n  if (s.collected.find(c => c.postId === id)) continue;\n  const views = Number(pick(m, ['play_count', 'ig_play_count', 'view_count', 'views']) || 0);\n  if (!(views > 10000)) continue;\n  const takenAt = Number(pick(m, ['taken_at', 'taken_at_timestamp', 'device_timestamp']) || 0);\n  if (takenAt && takenAt < s.cutoffTs) continue;\n  const shortcode = pick(m, ['code', 'shortcode']) || '';\n  const likes = Number(pick(m, ['like_count', 'likes']) || 0);\n  const comments = Number(pick(m, ['comment_count', 'comments']) || 0);\n  const user = m.user || m.owner || {};\n  const username = pick(user, ['username']) || '';\n  const followers = Number(pick(user, ['follower_count', 'followers']) || 0);\n  const accountId = (pick(user, ['pk', 'id']) || '').toString();\n  let caption = pick(m, ['caption.text']);\n  if (!caption && typeof m.caption === 'string') caption = m.caption;\n  caption = caption || '';\n  s.collected.push({ postId: id, shortcode, views, likes, comments, takenAt, username, followers, accountId, caption });\n}\ns.page = s.page + 1;\nreturn [{ json: { collected: s.collected.length, page: s.page } }];"
      },
      "id": "Filtr_va_yigish",
      "name": "Filtr va yigish",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2040,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $getWorkflowStaticData('global').searchState;\nconst list = s.collected.slice(0, s.miqdor);\nfunction faollik(views, likes, followers) {\n  let reach;\n  if (followers > 0) {\n    const ratio = views / followers;\n    reach = Math.min(100, (Math.log10(ratio + 1) / Math.log10(11)) * 100);\n  } else {\n    reach = views > 50000 ? 100 : (views / 50000) * 100;\n  }\n  let eng = 0;\n  if (views > 0) {\n    const er = likes / views;\n    eng = Math.min(100, (er / 0.10) * 100);\n  }\n  return Math.round(Math.min(100, Math.max(0, 0.6 * reach + 0.4 * eng)));\n}\nconst today = new Date().toISOString().slice(0, 10);\nconst videos = list.map(c => ({\n  'Akkaunt': c.username,\n  'Opisaniya': c.caption,\n  'Havola': c.shortcode ? `https://www.instagram.com/reel/${c.shortcode}/` : '',\n  'Status': 'Yangi',\n  'Skript tili': 'Uzbek',\n  'Obunachilar': c.followers,\n  'Faollik': faollik(c.views, c.likes, c.followers),\n  \"Ko'rilishlar\": c.views,\n  'Layklar': c.likes,\n  'Kommentlar': c.comments,\n  'Post sanasi': c.takenAt ? new Date(c.takenAt * 1000).toISOString().slice(0, 10) : '',\n  'Kiritilish sanasi': today,\n  'Post IDsi': c.postId,\n  'Akkaunt IDsi': c.accountId\n}));\nreturn [{ json: { videos, savedCount: videos.length, rowNumber: s.rowNumber } }];"
      },
