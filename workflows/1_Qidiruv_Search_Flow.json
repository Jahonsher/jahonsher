    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.scrapecreators.com/v2/instagram/reels/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $getWorkflowStaticData('global').searchState.query }}"
            },
            {
              "name": "date_posted",
              "value": "={{ $getWorkflowStaticData('global').searchState.date_posted }}"
            },
            {
