    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst S = v => (v == null ? '' : v.toString().trim());\nlet chosen = null;\nfor (const r of rows) { if (S(r['Status']) === 'Boshlash') chosen = r; }\nif (!chosen && rows.length) chosen = rows[rows.length - 1];\nif (!chosen) throw new Error(\"Buyruqlar varagi bosh — kamida 1 qator toldiring.\");\nconst vaqtMap = {\n  'Bugun': { date_posted: 'last-day', cutoffDays: 1 },\n  'Oxirgi hafta': { date_posted: 'last-week', cutoffDays: 7 },\n  'Oxirgi oy': { date_posted: 'last-month', cutoffDays: 30 },\n  'Oxirgi 3 oy': { date_posted: 'last-year', cutoffDays: 90 },\n  'Oxirgi 6 oy': { date_posted: 'last-year', cutoffDays: 180 },\n  \"So'ngi yil\": { date_posted: 'last-year', cutoffDays: 365 }\n};\nconst vaqt = S(chosen['Vaqt']);\nconst vm = vaqtMap[vaqt] || { date_posted: 'last-month', cutoffDays: 30 };\nconst miqdor = parseInt(chosen['Miqdor'], 10) || 10;\nreturn [{ json: {\n  query: S(chosen['Buyruq']),\n  miqdor,\n  date_posted: vm.date_posted,\n  cutoffDays: vm.cutoffDays,\n  rowNumber: chosen.row_number\n} }];"
      },
