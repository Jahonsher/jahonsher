      "parameters": {
        "jsCode": "const chatId = $('Execute Trigger').first().json.chatId;\nconst insta = $('Instagram oqish').all().map(i => i.json);\nconst skript = $('Skriptlar oqish').all().map(i => i.json);\nconst rask = $('Raskadrovka oqish').all().map(i => i.json);\nconst S = v => (v == null ? '' : v.toString().trim());\n\n// Ustuvorlik: A -> S -> B\nconst a = insta.find(r => S(r['Status']) === 'Skript yasash');\nif (a) {\n  return [{ json: { mode: 'A', chatId, havola: S(a['Havola']), postId: S(a['Post IDsi']),\n    account: S(a['Akkaunt']), accountId: S(a['Akkaunt IDsi']),\n    skriptTili: S(a['Skript tili']) || 'Uzbek', opisaniya: S(a['Opisaniya']),\n    instaRow: a.row_number } }];\n}\nconst s = rask.find(r => S(r['Status']) === 'Skript yaratish');\nif (s) {\n  return [{ json: { mode: 'S', chatId, havola: S(s['Havola']), postId: S(s['Post IDsi']),\n    account: S(s['Akkaunt']), skriptTili: S(s['Skript tili']) || 'Uzbek',\n    raskadrovka: S(s['Raskadrovka']), opisaniya: '', raskRow: s.row_number } }];\n}\nconst b = skript.find(r => S(r['Status']) === 'Qayta yozish');\nif (b) {\n  return [{ json: { mode: 'B', chatId, havola: S(b['Havola']), postId: S(b['Post IDsi']),\n    account: S(b['Akkaunt']), oldScript: S(b['Skript']), opisaniya: S(b['Opisaniya']),\n    insights: S(b['Insights skrinshotlari']), skriptRow: b.row_number } }];\n}\nreturn [{ json: { mode: 'none', chatId } }];"
      },
