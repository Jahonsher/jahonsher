        "jsCode": "const d = $input.first().json;\nconst parts = [];\nconst intro = `Sen viral kontent strategisisan. Quyidagi rasmlar — Instagram Insights statistikasi skrinshotlari (kam korilgan video). Avval shu statistikaga qarab video NEGA viral bolmaganini tahlil qil. Songra quyidagi REFERANS RASKADROVKA va ESKI SKRIPT asosida videoni VIRAL boladigan qilib QAYTA YOZ. Javobni ${d.tili} tilida yoz.`;\nparts.push({ text: intro });\nfor (const u of d.urls) {\n  try {\n    const buf = await this.helpers.httpRequest({ url: u, encoding: 'arraybuffer' });\n    const b64 = Buffer.from(buf).toString('base64');\n    let mime = 'image/jpeg';\n    if (/\\.png(\\?|$)/i.test(u)) mime = 'image/png';\n    else if (/\\.webp(\\?|$)/i.test(u)) mime = 'image/webp';\n    parts.push({ inline_data: { mime_type: mime, data: b64 } });\n  } catch (e) { /* rasmni otkazib yuboramiz */ }\n}\nparts.push({ text: `--- REFERANS RASKADROVKA ---\\n${d.raskadrovka}\\n\\n--- ESKI SKRIPT ---\\n${d.oldScript}` });\nconst geminiBody = {\n  contents: [{ parts }],\n  generationConfig: { temperature: 0.9, maxOutputTokens: 8192 }\n};\nreturn [{ json: { geminiBody } }];"
