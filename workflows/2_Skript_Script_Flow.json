    {
      "parameters": {
        "jsCode": "const tili = $('Vazifani tanlash').first().json.skriptTili || 'Uzbek';\nconst buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst b64 = buf.toString('base64');\nconst prompt = `Sen professional video montaj va kontent tahlilchisisan. Quyidagi videoni SONIYALAR boyicha toliq raskadrovka qil. Har bir sahna uchun: vaqt oraligi (masalan \"0-3 son\"), kadrda nima korinayotgani, ekrandagi matnlar (text/titrlar), harakatlar, montaj uslubi va otishlar (transitions). Javobni ${tili} tilida yoz. Faqat raskadrovkani qaytar, ortiqcha izoh berma.`;\nconst geminiBody = {\n  contents: [{ parts: [\n    { inline_data: { mime_type: 'video/mp4', data: b64 } },\n    { text: prompt }\n  ] }],\n  generationConfig: { temperature: 0.4, maxOutputTokens: 8192 }\n};\nreturn [{ json: { geminiBody } }];"
      },
