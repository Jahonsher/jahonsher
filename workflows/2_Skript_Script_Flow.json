    {
      "parameters": {
        "jsCode": "const t = $('Vazifani tanlash').first().json;\nconst base = $('SCRIPT PROMPT').first().json.prompt || '';\nconst tr = $input.first().json || {};\nlet transcript = '';\ntry {\n  if (tr.transcripts) transcript = JSON.stringify(tr.transcripts);\n  else if (tr.transcript) transcript = tr.transcript;\n  else if (tr.text) transcript = tr.text;\n  else transcript = JSON.stringify(tr);\n} catch (e) { transcript = ''; }\nconst prompt = `${base}\n\n--- TIL: ${t.skriptTili} ---\n\n--- VIDEO TRANSCRIPT (audio matni) ---\n${transcript}\n\n--- VIDEO RASKADROVKA ---\n${t.raskadrovka}\n\n--- CAPTION / OPISANIYA ---\n${t.opisaniya || ''}\n\nYuqoridagi malumotlar asosida yangi, original va viral boladigan skript yoz. Javobni ${t.skriptTili} tilida yoz.`;\nconst geminiBody = {\n  contents: [{ parts: [{ text: prompt }] }],\n  generationConfig: { temperature: 0.9, maxOutputTokens: 8192 }\n};\nreturn [{ json: { geminiBody } }];"
      },
